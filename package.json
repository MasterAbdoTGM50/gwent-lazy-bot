{
  "name": "gwent-lazy-bot",
  "version": "1.0.0",
  "description": "Very Lazy Implementation for a GWENT Card Bot",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "register-commands": "bun scripts/register-commands.ts",
    "update-cards": "bun scripts/update-cards.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MasterAbdoTGM50/gwent-lazy-bot.git"
  },
  "bugs": {
    "url": "https://github.com/MasterAbdoTGM50/gwent-lazy-bot/issues"
  },
  "homepage": "https://github.com/MasterAbdoTGM50/gwent-lazy-bot#readme",
  "author": "MasterAbdoTGM50",
  "license": "MIT",
  "engines": {
    "bun": ">=1.4"
  },
  "dependencies": {
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
