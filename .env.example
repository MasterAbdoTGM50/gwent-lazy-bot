# Copy to .env (Bun loads it automatically) and fill in.

# Bot token from https://discord.com/developers/applications -> Bot
DISCORD_TOKEN=

# Comma-separated Discord user IDs allowed to change any channel's language, even without
# Manage Channels. Defaults to the bot author (DEFAULT_OWNER_IDS in src/config.ts).
# OWNER_IDS=

# Where the bot keeps its database and downloaded card data. A relative path is resolved against
# the project folder, not the directory the bot is started from. Default: storage
# DATA_DIR=storage

# gwent.one API key. The public key "data" is the default; only set this if gwent.one gives you one.
# GWENT_API_KEY=data
